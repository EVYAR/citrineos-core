# Core OCPP app — Dockerfile: apps/ocpp-server/deploy.Dockerfile.ir
# ConfigLoader reads CITRINEOS_ schema paths directly; no persisted bootstrap or aliases.
APP_NAME=all
CITRINEOS_ENV=production
CITRINEOS_HOST=0.0.0.0
CITRINEOS_PORT=8080
# Reviewed offline migration AND partition provisioning must finish before runtime.
# none skips both DDL paths. Unset/empty defaults to upstream migrate; unknown fails.
DB_STRATEGY=none

CITRINEOS_DATABASE_HOST=${{environment.CORE_DB_HOST}}
CITRINEOS_DATABASE_PORT=5432
CITRINEOS_DATABASE_DATABASE=${{environment.PG_DB}}
CITRINEOS_DATABASE_USERNAME=${{environment.PG_USER}}
CITRINEOS_DATABASE_PASSWORD=${{environment.PG_PASSWORD}}
CITRINEOS_DATABASE_SYNC=false
CITRINEOS_DATABASE_ALTER=false
CITRINEOS_DATABASE_FORCE=false

CITRINEOS_MESSAGEBROKER_AMQP_URL=amqp://${{environment.RABBITMQ_USER}}:${{environment.RABBITMQ_PASS}}@${{environment.CORE_MQ_HOST}}:5672
CITRINEOS_CACHE_TYPE=redis
CITRINEOS_CACHE_URL=redis://:${{environment.REDIS_PASSWORD}}@${{environment.CORE_REDIS_HOST}}:6379

# File-access root holds reviewed websocket/role/TLS assets, NOT a bootstrap config.
CITRINEOS_FILEACCESS_TYPE=s3
CITRINEOS_FILEACCESS_S3_REGION=us-east-1
CITRINEOS_FILEACCESS_S3_ENDPOINT=http://${{environment.CORE_MINIO_HOST}}:9000
CITRINEOS_FILEACCESS_S3_DEFAULTBUCKETNAME=${{environment.MINIO_BUCKET}}
CITRINEOS_FILEACCESS_S3_S3FORCEPATHSTYLE=true
CITRINEOS_FILEACCESS_S3_ACCESSKEYID=${{environment.MINIO_USER}}
CITRINEOS_FILEACCESS_S3_SECRETACCESSKEY=${{environment.MINIO_PASS}}
CITRINEOS_WEBSOCKETSERVERCONFIGFILE=${{environment.CORE_WEBSOCKET_SERVER_CONFIG_FILE}}
CITRINEOS_ROLES_SEEDFILE=${{environment.CORE_ROLES_SEED_FILE}}
# This image-local logo path is independent of S3 file-access root.
CITRINEOS_SWAGGER_LOGOPATH=dist/assets/logo.png

# Dedicated IAM Core audience; canonical product tenant_id remains a GUID.
CITRINEOS_AUTH_MODE=jwt
CITRINEOS_AUTH_JWT_JWKSURI=${{environment.IAM_JWKS_URI}}
CITRINEOS_AUTH_JWT_ISSUER=${{environment.IAM_ISSUER}}
CITRINEOS_AUTH_JWT_AUDIENCE=citrineos-core
CITRINEOS_AUTH_JWT_TENANTCLAIM=core_tenant_id
CITRINEOS_AUTH_JWT_ROLESCLAIM=core_roles
CITRINEOS_AUTH_JWT_REQUIREDTENANTCLAIM=true

# Preserve observed dev proxy targets: core.dev -> HTTP8080,
# ocpp16.dev -> WS8081, ocpp.dev -> WS8082. These are internal target ports,
# not public ports and not proof of protocol/security-profile compatibility.
# CORE_WEBSOCKET_SERVER_CONFIG_FILE must name the separately reviewed/provisioned
# EVYAR asset for these routes: IDs, allowed protocols, tenant/dynamicTenantResolution,
# station admission, Basic/TLS/mTLS profiles and certificate paths all need validation.
# Upstream bundled websocket-servers.json mixes all protocols on8081(profile0)
# and8082(profile1), plus TLS8443/mTLS8444; it does NOT establish current dev mapping.
# Do not publish bundled sample private keys or silently substitute default profiles.
# Publish matching Core role seed before startup (machine role inventories reviewed
# per service); IAM issuer grants and actual secret provisioning are parent-owned.
# See docs/upstream/core-runtime-regressions-20261107.md for manual cutover boundary.
