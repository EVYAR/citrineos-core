ARG NODE_IMAGE=git.ev-yar.ir/evyar/node:24.16.0-alpine
ARG NPM_REGISTRY=http://89.42.199.156:4873/

FROM ${NODE_IMAGE} AS build
WORKDIR /usr/local/apps/citrineos

# Use the internal Verdaccio mirror directly because Corepack's metadata lookup
# against the public npm registry is not reliably reachable from the Iran host.
ARG NPM_REGISTRY
RUN npm config set registry "$NPM_REGISTRY" \
    && npm config set replace-registry-host always \
    && npm config set audit false \
    && npm config set fund false \
    && npm install --global pnpm@10.19.0
ENV npm_config_nodedir=/usr/local

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --filter "@citrineos/ocpp-server..." build

FROM ${NODE_IMAGE} AS runtime

ARG NPM_REGISTRY
RUN npm config set registry "$NPM_REGISTRY" \
    && npm config set replace-registry-host always \
    && npm config set audit false \
    && npm config set fund false \
    && npm install --global pnpm@10.19.0

COPY --from=build /usr/local/apps/citrineos /usr/local/apps/citrineos

WORKDIR /usr/local/apps/citrineos

RUN chmod +x /usr/local/apps/citrineos/apps/ocpp-server/entrypoint.sh

EXPOSE ${PORT}

ENTRYPOINT ["/usr/local/apps/citrineos/apps/ocpp-server/entrypoint.sh"]